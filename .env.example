# Copy to .env (cp .env.example .env). Every setting in the project comes from here.
# docker-compose.yml reads the MYSQL_* values too, so credentials live in one place.

# Kafka (layer 2)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=machine-temperature
SENSOR_ID=machine-1
CONSUMER_GROUP=scoring

# MySQL (layer 5). Host port 3307 avoids clashing with a local MySQL on 3306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=machine_monitor
MYSQL_USER=monitor
MYSQL_PASSWORD=monitor_pass
MYSQL_ROOT_PASSWORD=root_pass

# Files, relative to the repo root
DATA_CSV=data/machine_temperature_system_failure.csv
ANOMALY_WINDOWS=data/anomaly_windows.json
MODEL_PATH=models/anomaly_model.joblib
